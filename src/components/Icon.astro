---

{
	filledIcons[name] ? (
		<svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d={filledIcons[name]} />
		</svg>
	) : strokeIcons[name] ? (
		<svg
			class={className}
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.8"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			{strokeIcons[name].paths.map((d) => <path d={d} />)}
			{strokeIcons[name].circles?.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} />)}
		</svg>
	) : (
		<svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<circle cx="12" cy="12" r="10" class="stroke-current" stroke-width="1.8" />
		</svg>
	)
}