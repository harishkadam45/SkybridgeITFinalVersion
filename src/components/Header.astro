---
import { SITE, NAV } from '../data/site';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href: string) {
	const h = href.replace(/\/+$/, '') || '/';
	if (h === '/') return pathname === '/';
	return pathname === h || pathname.startsWith(h + '/');
}

type NavItem = { label: string; href: string; children?: NavItem[] };

const byLabel = (label: string) => NAV.find((n) => n.label === label) as NavItem;

// Navigation mirrors the reference structure but keeps real page links
const desktopNav: NavItem[] = [
	{ label: 'About us', href: '/about-us/' },
	{ label: 'Services', href: '/services/', children: byLabel('Services').children },
	{ label: 'Our Team', href: '/member/' },
	{ label: 'AI Services', href: byLabel('AI Services').href, children: byLabel('AI Services').children },
	{ label: 'Go High Level', href: byLabel('Go High Level').href },
	{ label: 'WordPress', href: byLabel('WordPress').href, children: byLabel('WordPress').children },
	{ label: 'Gaming App', href: '/gaming-app/' },
	{ label: 'Website Maintenance', href: '/website-maintenance/' },
];
---

<header class="relative z-50 w-full transition-all duration-300" id="site-header">
	{/* Top information bar */}
	<div class="hidden border-b border-slate-200/80 bg-[#F1F5F9] px-4 py-2.5 text-xs text-slate-700 md:block sm:px-8">
		<div class="mx-auto flex max-w-[1400px] items-center justify-between">
			<div class="flex items-center space-x-6">
				<a href={`mailto:${SITE.email}`} class="flex items-center space-x-2 font-medium hover:text-brand-600">
					<span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-sm bg-brand-600 text-white">
						<Icon name="mail" class="h-3 w-3" />
					</span>
					<span>{SITE.email}</span>
				</a>
				<a href={SITE.phoneHref} class="flex items-center space-x-2 font-medium hover:text-brand-600">
					<Icon name="phone" class="h-4 w-4 text-brand-600" />
					<span>{SITE.phone}</span>
				</a>
				<a
					href={SITE.isoPath}
					class="flex items-center space-x-2 border-l border-slate-300/60 pl-6 font-medium hover:text-brand-600"
				>
					<Icon name="shield" class="h-4 w-4 text-brand-600" />
					<span>{SITE.isoLabel}</span>
				</a>
			</div>
			<div class="flex items-center space-x-5">
				<a href="/contact-us/" class="font-bold text-slate-700 hover:text-brand-600">Contact Us</a>
				<a
					href={SITE.calendly}
					target="_blank"
					rel="noopener"
					class="rounded-full bg-brand-600 px-5 py-1.5 text-xs font-bold text-white shadow-sm hover:bg-brand-700"
				>
					Schedule a Meeting
				</a>
				<div class="flex items-center space-x-2.5 pl-2">
					<a
						href={SITE.linkedin}
						target="_blank"
						rel="noopener"
						aria-label="LinkedIn"
						class="flex h-7 w-7 items-center justify-center rounded-sm bg-slate-800 text-white transition-colors hover:bg-brand-600"
					>
						<Icon name="linkedin" class="h-3.5 w-3.5" />
					</a>
					<a
						href={SITE.youtube}
						target="_blank"
						rel="noopener"
						aria-label="YouTube"
						class="flex h-7 w-7 items-center justify-center rounded-sm bg-slate-800 text-white transition-colors hover:bg-brand-600"
					>
						<Icon name="youtube" class="h-3.5 w-3.5" />
					</a>
					<a
						href={SITE.whatsapp}
						target="_blank"
						rel="noopener"
						aria-label="WhatsApp"
						class="flex h-7 w-7 items-center justify-center rounded-sm bg-slate-800 text-white transition-colors hover:bg-brand-600"
					>
						<Icon name="whatsapp" class="h-3.5 w-3.5" />
					</a>
				</div>
			</div>
		</div>
	</div>

	{/* Main navigation bar */}
	<nav
		data-main-nav
		class="w-full border-b border-slate-100 bg-white py-4 transition-all duration-300"
		aria-label="Primary"
	>
		<div class="mx-auto flex max-w-[1400px] items-center justify-between px-4 sm:px-8">
			<a href="/" class="group flex shrink-0 items-center" aria-label={SITE.name}>
				<img
					src="/images/Logo.png"
					alt="Skybridge IT Consulting Logo"
					class="h-14 w-auto object-contain sm:h-[76px]"
					width="280"
					height="152"
					loading="eager"
				/>
			</a>

			{/* Desktop nav links */}
			<div class="hidden items-center space-x-6 text-sm font-semibold text-slate-800 xl:flex">
				{desktopNav.map((item) =>
					item.children ? (
						<div class="group relative">
							<button
								type="button"
								class={`flex items-center space-x-1 py-1 transition-colors hover:text-brand-600 ${isActive(item.href) ? 'text-brand-600' : ''}`}
							>
								<span>{item.label}</span>
								<Icon name="chevronDown" class="h-3.5 w-3.5 text-slate-500 transition-transform duration-200 group-hover:rotate-180" />
							</button>
							<div class="invisible absolute left-0 top-full z-50 translate-y-2 py-3 opacity-0 transition-all duration-150 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
								<ul class={`w-64 rounded-2xl border border-slate-100 bg-white py-3 shadow-xl ${item.label === 'WordPress' ? 'w-72' : ''}`}>
									{item.children.map((child) => (
										<li>
											<a
												href={child.href}
												class={`block px-5 py-2 text-xs font-semibold transition-colors hover:bg-ice-blue hover:text-brand-600 ${isActive(child.href) ? 'text-brand-600' : ''}`}
											>
												{child.label}
											</a>
										</li>
									))}
								</ul>
							</div>
						</div>
					) : (
						<a
							href={item.href}
							class={`py-1 transition-colors hover:text-brand-600 ${isActive(item.href) ? 'text-brand-600' : ''}`}
						>
							{item.label}
						</a>
					),
				)}
			</div>

			{/* Desktop right CTA */}
			<div class="hidden shrink-0 items-center xl:flex">
				<a
					href="/contact-us/"
					class="inline-flex items-center justify-center rounded-full bg-brand-600 px-6 py-2.5 text-sm font-bold text-white shadow-md shadow-brand-600/30 transition-all hover:-translate-y-0.5 hover:bg-brand-700 hover:shadow-lg hover:shadow-brand-700/40"
				>
					<span>Start a Project</span>
					<Icon name="arrowRight" class="ml-2 h-4 w-4" />
				</a>
			</div>

			{/* Mobile hamburger */}
			<div class="flex items-center xl:hidden">
				<button
					type="button"
					class="rounded-xl p-2 text-navy transition-colors hover:bg-slate-100"
					data-menu-toggle
					aria-label="Toggle navigation"
					aria-expanded="false"
				>
					<Icon name="menu" class="h-6 w-6" data-menu-open-icon />
					<Icon name="close" class="hidden h-6 w-6" data-menu-close-icon />
				</button>
			</div>
		</div>

		{/* Mobile drawer */}
		<div class="xl:hidden" data-mobile-menu hidden>
			<nav aria-label="Mobile" class="max-h-[70vh] overflow-y-auto border-b border-slate-100 bg-white px-6 py-6 shadow-xl">
				<ul class="space-y-3">
					{desktopNav.map((item) => (
						<li>
							{item.children ? (
								<div>
									<button
										type="button"
										class="flex w-full items-center justify-between py-2 font-semibold text-navy hover:text-brand-600"
										data-accordion
										aria-expanded="false"
									>
										<span>{item.label}</span>
										<Icon name="chevronDown" class="h-4 w-4" data-chevron />
									</button>
									<div class="hidden border-b border-slate-50 pb-2 pl-3" data-panel>
										{item.children.map((child) => (
											<a
												href={child.href}
												class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-ice-blue hover:text-brand-600"
											>
												{child.label}
											</a>
										))}
									</div>
								</div>
							) : (
								<a
									href={item.href}
									class="block border-b border-slate-50 py-2 font-semibold text-navy hover:text-brand-600"
								>
									{item.label}
								</a>
							)}
						</li>
					))}
				</ul>
				<div class="space-y-3 pt-3">
					<a href="/contact-us/" class="inline-flex w-full items-center justify-center rounded-full bg-brand-600 px-6 py-3 text-sm font-bold text-white shadow-md shadow-brand-600/25" data-mobile-close>
						<span>Start a Project</span>
						<Icon name="arrowRight" class="ml-2 h-4 w-4" />
					</a>
					<a
						href={SITE.calendly}
						target="_blank"
						rel="noopener"
						class="inline-flex w-full items-center justify-center rounded-full border border-brand-600 px-6 py-3 text-sm font-bold text-brand-600 transition-colors hover:bg-brand-600 hover:text-white"
						data-mobile-close
					>
						Schedule a Meeting
					</a>
				</div>
			</nav>
		</div>
	</nav>
</header>

<script>
	const toggle = document.querySelector('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
	const openIcon = document.querySelector('[data-menu-open-icon]');
	const closeIcon = document.querySelector('[data-menu-close-icon]');
	const nav = document.querySelector<HTMLElement>('[data-main-nav]');

	function setOpen(open: boolean) {
		if (!menu || !toggle || !openIcon || !closeIcon) return;
		menu.hidden = !open;
		openIcon.classList.toggle('hidden', open);
		closeIcon.classList.toggle('hidden', !open);
		toggle.setAttribute('aria-expanded', String(open));
	}

	toggle?.addEventListener('click', () => setOpen(menu ? !menu.hidden : false));

	document.querySelectorAll<HTMLButtonElement>('[data-accordion]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const panel = btn.nextElementSibling as HTMLElement | null;
			const chevron = btn.querySelector('[data-chevron]');
			const expanded = btn.getAttribute('aria-expanded') === 'true';
			btn.setAttribute('aria-expanded', String(!expanded));
			panel?.classList.toggle('hidden', expanded);
			chevron?.classList.toggle('rotate-180', !expanded);
		});
	});

	document.querySelectorAll<HTMLAnchorElement>('[data-mobile-menu] a').forEach((a) => {
		a.addEventListener('click', () => setOpen(false));
	});

	// Sticky nav per reference (isSticky = scrollY > 20)
	const onScroll = () => {
		if (!nav) return;
		const sticky = window.pageYOffset > 20;
		nav.classList.toggle('sticky', sticky);
		nav.classList.toggle('top-0', sticky);
		nav.classList.toggle('py-3', sticky);
		nav.classList.toggle('py-4', !sticky);
		nav.classList.toggle('bg-white/95', sticky);
		nav.classList.toggle('shadow-md', sticky);
		nav.classList.toggle('backdrop-blur-md', sticky);
	};
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();
</script>