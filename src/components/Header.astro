---
import { SITE, NAV } from '../data/site';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href: string) {
	const h = href.replace(/\/+$/, '') || '/';
	if (h === '/') return pathname === '/';
	return pathname === h || pathname.startsWith(h + '/');
}

type NavItem = { label: string; href: string; children?: NavItem[] };

const byLabel = (label: string) => NAV.find((n) => n.label === label) as NavItem;

// Navigation mirrors the reference structure but keeps real page links
const desktopNav: NavItem[] = [
	{ label: 'Home', href: '/' },
	{ label: 'About us', href: '/about-us/' },
	{ label: 'Services', href: '/services/', children: byLabel('Services').children },
	{ label: 'Our Team', href: '/our-team/' },
	{ label: 'AI Services', href: byLabel('AI Services').href, children: byLabel('AI Services').children },
	{ label: 'Go High Level', href: byLabel('Go High Level').href },
	{ label: 'WordPress', href: byLabel('WordPress').href, children: byLabel('WordPress').children },
	{ label: 'Gaming App', href: '/gaming-app/' },
	{ label: 'Website Maintenance', href: '/website-maintenance/' },
];
---

{/* Top information bar - scrolls away; only the main nav below stays pinned */}
<div class="hidden border-b border-slate-200/80 bg-slate-50 text-xs text-slate-700 md:block">
	<div class="container-x flex h-11 items-center justify-between">
		<div class="flex items-center gap-6">
			<a
				href={`https://mail.google.com/mail/?view=cm&fs=1&to=${SITE.email}`}
				target="_blank"
				rel="noopener"
				class="flex items-center gap-2 font-medium transition-colors hover:text-brand-700"
			>
				<span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-sm bg-brand-700 text-white">
					<Icon name="mail" class="h-3 w-3" />
				</span>
				<span>{SITE.email}</span>
			</a>
			<a href={SITE.phoneHref} class="flex items-center gap-2 font-medium transition-colors hover:text-brand-700">
				<Icon name="whatsapp" class="h-4 w-4 text-[#25D366]" />
				<span>{SITE.phone}</span>
			</a>
			<a
				href={SITE.isoPath}
				class="hidden items-center gap-2 border-l border-slate-300/60 pl-6 font-medium transition-colors hover:text-brand-700 lg:flex"
			>
				<Icon name="shield" class="h-4 w-4 text-brand-700" />
				<span>{SITE.isoLabel}</span>
			</a>
		</div>
		<div class="flex items-center gap-5">
			<a href="/contact-us/" class="font-bold text-slate-700 transition-colors hover:text-brand-700">Contact Us</a>
			<a
				href={SITE.calendly}
				target="_blank"
				rel="noopener"
				class="rounded-full bg-brand-700 px-4 py-1.5 text-xs font-bold text-white shadow-sm transition-colors hover:bg-brand-800"
			>
				Schedule a Meeting
			</a>
			<div class="flex items-center gap-2">
				{[
					{ href: SITE.linkedin, label: 'LinkedIn', icon: 'linkedin' },
					{ href: SITE.youtube, label: 'YouTube', icon: 'youtube' },
					{ href: SITE.whatsapp, label: 'WhatsApp', icon: 'whatsapp' },
				].map((s) => (
					<a
						href={s.href}
						target="_blank"
						rel="noopener"
						aria-label={s.label}
						class="group flex h-8 w-8 items-center justify-center rounded-full bg-brand-50 text-brand-700 ring-1 ring-brand-100 transition-colors hover:bg-brand-700 hover:text-white"
					>
						<Icon
							name={s.icon}
							class={
								s.icon === 'whatsapp'
									? 'h-4 w-4 text-[#25D366] group-hover:text-white'
									: s.icon === 'youtube'
										? 'h-4 w-4 text-[#FF0000] group-hover:text-white'
										: 'h-4 w-4'
							}
						/>
					</a>
				))}
			</div>
		</div>
	</div>
</div>

<header
	id="site-header"
	data-header
	class="sticky top-0 z-50 w-full border-b border-slate-100 bg-white/90 backdrop-blur-md transition-shadow duration-300 data-scrolled:shadow-[0_8px_24px_-12px_rgba(11,19,42,0.18)]"
>
	<nav aria-label="Primary" class="container-x flex h-(--header-h) items-center justify-between gap-4 2xl:gap-6">
		<a href="/" class="flex shrink-0 items-center" aria-label={`${SITE.name} - home`}>
			<img
				src="/images/logo-mark.webp"
				alt="SkyBridge IT Consulting"
				class="h-11 w-auto 2xl:h-12"
				width="301"
				height="109"
				loading="eager"
				decoding="async"
			/>
		</a>

		{/* Desktop nav links */}
		<div class="hidden min-w-0 items-center gap-x-2.5 text-sm font-semibold text-slate-800 xl:flex 2xl:gap-x-3">
			{desktopNav.map((item) =>
				item.children ? (
					<div class="group relative shrink-0">
						<button
							type="button"
							aria-haspopup="true"
							class={`flex items-center gap-1 whitespace-nowrap py-2 transition-colors hover:text-brand-700 ${isActive(item.href) ? 'text-brand-700' : ''}`}
						>
							<span>{item.label}</span>
							<Icon name="chevronDown" class="h-3.5 w-3.5 text-slate-500 transition-transform duration-200 group-hover:rotate-180" />
						</button>
						<div class="invisible absolute left-0 top-full z-50 translate-y-2 pt-3 opacity-0 transition-all duration-150 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
							<ul class={`rounded-2xl border border-slate-100 bg-white py-3 shadow-xl ${item.label === 'WordPress' ? 'w-72' : 'w-64'}`}>
								{item.children.map((child) => (
									<li>
										<a
											href={child.href}
											class={`block px-5 py-2 text-[13px] font-semibold transition-colors hover:bg-ice-blue hover:text-brand-700 ${isActive(child.href) ? 'text-brand-700' : ''}`}
										>
											{child.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					</div>
				) : (
					<a
						href={item.href}
						aria-current={isActive(item.href) ? 'page' : undefined}
						class={`shrink-0 whitespace-nowrap py-2 transition-colors hover:text-brand-700 ${isActive(item.href) ? 'text-brand-700' : ''}`}
					>
						{item.label}
					</a>
				),
			)}
		</div>

		{/* Desktop right CTA */}
		<a href="/contact-us/" class="btn-primary hidden min-h-11 shrink-0 whitespace-nowrap px-5 py-2.5 xl:ml-3 xl:-mr-2 xl:inline-flex 2xl:px-6">
			<span>Start a Project</span>
			<Icon name="arrowRight" class="hidden h-4 w-4 2xl:block" />
		</a>

		{/* Mobile hamburger */}
		<button
			type="button"
			class="flex h-11 w-11 items-center justify-center rounded-xl text-navy-950 transition-colors hover:bg-slate-100 xl:hidden"
			data-menu-toggle
			aria-label="Toggle navigation"
			aria-controls="mobile-menu"
			aria-expanded="false"
		>
			<Icon name="menu" class="h-6 w-6" data-menu-open-icon />
			<Icon name="close" class="hidden h-6 w-6" data-menu-close-icon />
		</button>
	</nav>

	{/* Mobile drawer */}
	<div id="mobile-menu" class="xl:hidden" data-mobile-menu hidden>
		<div class="max-h-[calc(100dvh-var(--header-h))] overflow-y-auto border-t border-slate-100 bg-white px-4 pb-6 pt-3 shadow-xl sm:px-6">
			<ul class="divide-y divide-slate-100">
				{desktopNav.map((item) => (
					<li>
						{item.children ? (
							<div>
								<button
									type="button"
									class="flex w-full items-center justify-between py-3 font-semibold text-navy-950 hover:text-brand-700"
									data-accordion
									aria-expanded="false"
								>
									<span>{item.label}</span>
									<Icon name="chevronDown" class="h-4 w-4 transition-transform" data-chevron />
								</button>
								<div class="hidden pb-3 pl-3" data-panel>
									{item.children.map((child) => (
										<a
											href={child.href}
											class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-ice-blue hover:text-brand-700"
										>
											{child.label}
										</a>
									))}
								</div>
							</div>
						) : (
							<a href={item.href} class="block py-3 font-semibold text-navy-950 hover:text-brand-700">
								{item.label}
							</a>
						)}
					</li>
				))}
			</ul>
			<div class="grid gap-3 pt-4 sm:grid-cols-2">
				<a href="/contact-us/" class="btn-primary w-full">
					<span>Start a Project</span>
					<Icon name="arrowRight" class="h-4 w-4" />
				</a>
				<a href={SITE.calendly} target="_blank" rel="noopener" class="btn-outline w-full">
					Schedule a Meeting
				</a>
			</div>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
	const openIcon = document.querySelector('[data-menu-open-icon]');
	const closeIcon = document.querySelector('[data-menu-close-icon]');

	function setOpen(open: boolean) {
		if (!menu || !toggle) return;
		menu.hidden = !open;
		openIcon?.classList.toggle('hidden', open);
		closeIcon?.classList.toggle('hidden', !open);
		toggle.setAttribute('aria-expanded', String(open));
	}

	toggle?.addEventListener('click', () => setOpen(Boolean(menu?.hidden)));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && menu && !menu.hidden) {
			setOpen(false);
			toggle?.focus();
		}
	});
	window.matchMedia('(min-width: 1280px)').addEventListener('change', (e) => e.matches && setOpen(false));

	document.querySelectorAll<HTMLButtonElement>('[data-accordion]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const panel = btn.nextElementSibling as HTMLElement | null;
			const expanded = btn.getAttribute('aria-expanded') === 'true';
			btn.setAttribute('aria-expanded', String(!expanded));
			panel?.classList.toggle('hidden', expanded);
			btn.querySelector('[data-chevron]')?.classList.toggle('rotate-180', !expanded);
		});
	});

	menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

	// Elevation cue once the page scrolls under the sticky header (no size change → no layout shift)
	if (header) {
		const sentinel = document.createElement('div');
		sentinel.setAttribute('aria-hidden', 'true');
		sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px;pointer-events:none';
		document.body.prepend(sentinel);
		new IntersectionObserver(([entry]) => header.toggleAttribute('data-scrolled', !entry.isIntersecting), {
			rootMargin: '40px 0px 0px 0px',
		}).observe(sentinel);
	}
</script>
