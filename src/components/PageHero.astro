---
import { SITE } from '../data/site';
import Icon from './Icon.astro';

interface Props {
	title: string;
	subtitle?: string;
	breadcrumb: { label: string; href?: string }[];
}

const { title, subtitle, breadcrumb } = Astro.props;
---

<section class="relative overflow-hidden border-b border-slate-100 bg-white px-4 py-16 sm:px-8 sm:py-24">
	{/* Decorative arcs */}
	<div class="pointer-events-none absolute inset-0 flex items-start justify-end overflow-hidden" aria-hidden="true">
		<svg class="h-[420px] w-[420px] -translate-y-24 translate-x-24 opacity-20" viewBox="0 0 1000 500" fill="none">
			<circle cx="500" cy="500" r="450" stroke="#0095FF" stroke-width="1" stroke-dasharray="2 4" />
			<circle cx="500" cy="500" r="370" stroke="#38BDF8" stroke-width="1.2" />
			<circle cx="500" cy="500" r="290" stroke="#0095FF" stroke-width="1" stroke-dasharray="3 3" />
			<circle cx="500" cy="500" r="210" stroke="#93C5FD" stroke-width="1.5" />
		</svg>
	</div>

	<div class="relative mx-auto max-w-[1400px]">
		<nav aria-label="Breadcrumb" class="mb-5">
			<ol class="flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-500">
				<li><a href="/" class="hover:text-brand-600">Home</a></li>
				{breadcrumb.map((c, i) => (
					<li class="flex items-center gap-2">
						<Icon name="chevronRight" class="h-3 w-3 text-slate-300" />
						{c.href ? (
							<a href={c.href} class="hover:text-brand-600">{c.label}</a>
						) : (
							<span class="text-brand-600" aria-current="page">{c.label}</span>
						)}
						{i === breadcrumb.length - 1 && <span class="sr-only">(current)</span>}
					</li>
				))}
			</ol>
		</nav>
		<h1 class="max-w-3xl text-balance text-4xl font-extrabold leading-[1.12] tracking-tight text-navy-950 sm:text-5xl">
			{title}
		</h1>
		{subtitle && <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-500">{subtitle}</p>}
		<div class="mt-8 flex flex-wrap items-center gap-4">
			<a href="/contact-us/" class="btn-primary">
				Contact Us
				<Icon name="arrowRight" class="h-4 w-4" />
			</a>
			<a href={SITE.calendly} target="_blank" rel="noopener" class="btn-outline">
				<Icon name="clock" class="h-4 w-4" />
				Schedule a Meeting
			</a>
		</div>
	</div>
</section>