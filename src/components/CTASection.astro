---
import { SITE } from '../data/site';
import Icon from './Icon.astro';

interface Props {
	title?: string;
	subtitle?: string;
}
const {
	title = "Let's build something remarkable.",
	subtitle = 'From your first concept to a market-ready digital product, SkyBridge IT Consulting bridges the gap between ambition and execution.',
} = Astro.props;

const trustBadges = ['SOC 2 Compliant', 'NDA on Request', '24/7 Availability', 'Free Discovery Call'];
---

<section class="relative overflow-hidden bg-white px-4 py-20 sm:px-8 sm:py-28">
	{/* Background wave lines */}
	<div class="pointer-events-none absolute inset-0 opacity-50" aria-hidden="true">
		<svg class="h-full w-full" preserveAspectRatio="none" viewBox="0 0 1440 320" fill="none">
			<path d="M-100 180 C 300 80, 700 280, 1540 160" stroke="#0095FF" stroke-width="1.5" stroke-opacity="0.3" />
			<path d="M-100 210 C 400 110, 800 310, 1540 190" stroke="#38BDF8" stroke-width="1.2" stroke-opacity="0.25" />
			<path d="M-100 150 C 250 250, 650 50, 1540 130" stroke="#7DD3FC" stroke-width="1" stroke-opacity="0.3" />
		</svg>
	</div>

	<div class="relative z-10 mx-auto max-w-4xl text-center">
		<span class="mb-3 block text-sm font-bold uppercase tracking-wider text-brand-600">Get Started</span>
		<h2 class="text-balance text-4xl font-extrabold leading-[1.12] tracking-tight text-[#0B132A] sm:text-5xl">
			{title}
		</h2>
		<p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-500">{subtitle}</p>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
			<a href={`mailto:${SITE.email}`} class="btn-primary">
				Book a Discovery Call
				<Icon name="arrowRight" class="h-4 w-4" />
			</a>
			<a href="/about-us/" class="btn-outline">Meet Our Team</a>
			<a
				href={SITE.whatsapp}
				target="_blank"
				rel="noopener"
				class="inline-flex items-center gap-2 rounded-full border border-emerald-300 bg-emerald-50 px-7 py-3.5 text-sm font-bold text-emerald-600 transition-colors hover:bg-emerald-500 hover:text-white"
			>
				<Icon name="whatsapp" class="h-4 w-4" />
				WhatsApp Us
			</a>
		</div>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-xs text-slate-500 sm:text-sm">
			{trustBadges.map((b) => (
				<span class="flex items-center gap-2">
					<Icon name="checkCircle" class="h-5 w-5 rounded-full border border-brand-600/40 text-brand-600" />
					{b}
				</span>
			))}
		</div>
	</div>
</section>