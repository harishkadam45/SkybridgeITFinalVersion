---
import { SITE } from '../data/site';
import Icon from './Icon.astro';

interface Props {
	title?: string;
	subtitle?: string;
}
const {
	title = "Let's build something remarkable.",
	subtitle = 'From your first concept to a market-ready digital product, SkyBridge IT Consulting bridges the gap between ambition and execution.',
} = Astro.props;

const trustBadges = ['SOC 2 Compliant', 'NDA on Request', '24/7 Availability', 'Free Discovery Call'];
---

<section class="section relative overflow-hidden bg-white">
	{/* Background wave lines */}
	<div class="pointer-events-none absolute inset-0 opacity-50" aria-hidden="true">
		<svg class="h-full w-full" preserveAspectRatio="none" viewBox="0 0 1440 320" fill="none">
			<path d="M-100 180 C 300 80, 700 280, 1540 160" stroke="#0095FF" stroke-width="1.5" stroke-opacity="0.3" />
			<path d="M-100 210 C 400 110, 800 310, 1540 190" stroke="#38BDF8" stroke-width="1.2" stroke-opacity="0.25" />
			<path d="M-100 150 C 250 250, 650 50, 1540 130" stroke="#7DD3FC" stroke-width="1" stroke-opacity="0.3" />
		</svg>
	</div>

	<div class="container-x relative z-10 max-w-4xl text-center">
		<span class="eyebrow">Get Started</span>
		<h2 class="heading-2">
			{title}
		</h2>
		<p class="lead mx-auto mt-4 max-w-2xl">{subtitle}</p>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
			<a href="/contact-us/" class="btn-primary">
				Book a Discovery Call
				<Icon name="arrowRight" class="h-4 w-4" />
			</a>
			<a href="/our-team/" class="btn-outline">Meet Our Team</a>
			<a
				href={SITE.whatsapp}
				target="_blank"
				rel="noopener"
				class="inline-flex min-h-12 items-center gap-2 rounded-full border border-emerald-300 bg-emerald-50 px-7 py-3 text-sm font-bold text-emerald-800 transition-colors hover:border-emerald-700 hover:bg-emerald-700 hover:text-white"
			>
				<Icon name="whatsapp" class="h-4 w-4" />
				WhatsApp Us
			</a>
		</div>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm text-slate-600">
			{trustBadges.map((b) => (
				<span class="flex items-center gap-2">
					<Icon name="checkCircle" class="h-5 w-5 text-brand-600" />
					{b}
				</span>
			))}
		</div>
	</div>
</section>