---
import { TESTIMONIALS } from '../data/content';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

interface Props {
	subtitle?: string;
	limit?: number;
	/** Background tone, so the section can alternate with its neighbours */
	tone?: 'white' | 'muted';
}
const { subtitle, limit = 6, tone = 'white' } = Astro.props;
const items = TESTIMONIALS.slice(0, limit);
const initials = (name: string) =>
	name
		.split(' ')
		.map((n) => n[0])
		.join('')
		.slice(0, 2);
---

<section class:list={['section', tone === 'muted' ? 'bg-white' : 'bg-white']} aria-label="Client testimonials">
	<div class="container-x">
		<SectionHeading
			eyebrow="Client Testimonials"
			title="Our customers love us."
			subtitle={subtitle ??
				'Trusted by marketing agencies, startups and enterprises as their silent white-label development partner.'}
			center
			class="section-head"
		/>

		<div data-testimonials aria-roledescription="carousel" aria-label="Client testimonials">
			{/*
			  overflow-x: clip (not hidden) clips off-screen slides horizontally while letting
			  shadows and the hover lift spill vertically; the -mx/px pair gives edge shadows room.
			*/}
			<div class="-mx-3 overflow-x-clip px-3">
			<div class="testimonial-viewport" data-viewport>
				<ul class="testimonial-track flex gap-6" data-track>
					{items.map((t, i) => (
						<li
							class="testimonial-slide flex shrink-0"
							data-slide
							aria-roledescription="slide"
							aria-label={`${i + 1} of ${items.length}`}
						>
							<figure class="flex w-full flex-col rounded-[28px] border border-slate-100 bg-gray-100 p-7 custom-shadow transition-[translate,box-shadow] duration-300 hover:-translate-y-1 hover:custom-shadow-hover sm:p-8">
								<div class="mb-5 flex items-center gap-1 text-[#FF6A00]" role="img" aria-label="Rated 5 out of 5">
									{Array.from({ length: 5 }).map(() => (
										<Icon name="star" class="h-[18px] w-[18px]" />
									))}
								</div>
								<blockquote class="flex-1 text-[15px] leading-relaxed text-slate-700 sm:text-base">
									<p>&ldquo;{t.quote}&rdquo;</p>
								</blockquote>
								<figcaption class="mt-7 flex min-h-[4.5rem] items-center gap-4 border-t border-slate-100 pt-6">
									<span
										class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-brand text-sm font-bold text-white"
										aria-hidden="true"
									>
										{initials(t.name)}
									</span>
									<span class="min-w-0">
										<span class="block font-bold text-navy-950">{t.name}</span>
										<span class="line-clamp-2 block text-sm text-slate-500">{t.role}</span>
									</span>
								</figcaption>
							</figure>
						</li>
					))}
				</ul>
			</div>
			</div>

			<div class="mt-10 flex items-center justify-center gap-4">
				<button
					type="button"
					class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-navy-950 transition-colors hover:border-brand-700 hover:text-brand-700 disabled:opacity-40"
					data-prev
					aria-label="Previous testimonials"
				>
					<Icon name="chevronLeft" class="h-5 w-5" />
				</button>
				<div class="flex items-center" data-dots></div>
				<button
					type="button"
					class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-navy-950 transition-colors hover:border-brand-700 hover:text-brand-700 disabled:opacity-40"
					data-next
					aria-label="Next testimonials"
				>
					<Icon name="chevronRight" class="h-5 w-5" />
				</button>
			</div>
		</div>
	</div>
</section>

<style>
	.testimonial-viewport {
		touch-action: pan-y;
	}
	.testimonial-track {
		--per: 1;
		--i: 0;
		transform: translateX(calc(var(--i) * -1 * (100% + 1.5rem) / var(--per)));
		transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
	}
	@media (min-width: 768px) {
		.testimonial-track {
			--per: 2;
		}
	}
	@media (min-width: 1024px) {
		.testimonial-track {
			--per: 3;
		}
	}
	/* slides inherit --per from the track */
	.testimonial-slide {
		flex-basis: calc((100% - (var(--per) - 1) * 1.5rem) / var(--per));
	}
</style>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('[data-testimonials]').forEach((root) => {
		const track = root.querySelector<HTMLElement>('[data-track]');
		const viewport = root.querySelector<HTMLElement>('[data-viewport]');
		const dots = root.querySelector<HTMLElement>('[data-dots]');
		const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
		const next = root.querySelector<HTMLButtonElement>('[data-next]');
		if (!track || !viewport) return;

		const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-slide]'));
		let index = 0;
		let perView = 1;
		let maxIndex = 0;

		const readPerView = () => Number(getComputedStyle(track).getPropertyValue('--per')) || 1;

		function render() {
			track!.style.setProperty('--i', String(index));
			slides.forEach((s, i) => s.setAttribute('aria-hidden', String(i < index || i >= index + perView)));
			dots?.querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-current', String(i === index)));
			if (prev) prev.disabled = maxIndex === 0;
			if (next) next.disabled = maxIndex === 0;
		}

		function buildDots() {
			if (!dots) return;
			dots.replaceChildren(
				...Array.from({ length: maxIndex + 1 }, (_, i) => {
					const b = document.createElement('button');
					b.type = 'button';
					b.className = 'carousel-dot';
					b.setAttribute('aria-label', `Show testimonial group ${i + 1}`);
					b.addEventListener('click', () => go(i));
					return b;
				}),
			);
		}

		function layout() {
			perView = readPerView();
			maxIndex = Math.max(slides.length - perView, 0);
			index = Math.min(index, maxIndex);
			buildDots();
			render();
		}

		function go(i: number) {
			index = (i + maxIndex + 1) % (maxIndex + 1);
			render();
			restart();
		}

		prev?.addEventListener('click', () => go(index - 1));
		next?.addEventListener('click', () => go(index + 1));

		// Swipe support
		let startX: number | null = null;
		viewport.addEventListener('pointerdown', (e) => (startX = e.clientX));
		viewport.addEventListener('pointerup', (e) => {
			if (startX === null) return;
			const dx = e.clientX - startX;
			startX = null;
			if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1));
		});

		// Autoplay: off for reduced motion, paused on hover/focus or when off-screen
		let timer: number | undefined;
		let inView = false;
		let hovered = false;
		function restart() {
			window.clearInterval(timer);
			if (reduceMotion || !inView || hovered || document.hidden) return;
			timer = window.setInterval(() => {
				index = index >= maxIndex ? 0 : index + 1;
				render();
			}, 6000);
		}
		root.addEventListener('mouseenter', () => ((hovered = true), restart()));
		root.addEventListener('mouseleave', () => ((hovered = false), restart()));
		root.addEventListener('focusin', () => ((hovered = true), restart()));
		root.addEventListener('focusout', () => ((hovered = false), restart()));
		document.addEventListener('visibilitychange', restart);
		new IntersectionObserver(([entry]) => {
			inView = entry.isIntersecting;
			restart();
		}).observe(root);

		['(min-width: 768px)', '(min-width: 1024px)'].forEach((q) =>
			window.matchMedia(q).addEventListener('change', layout),
		);
		layout();
	});
</script>
