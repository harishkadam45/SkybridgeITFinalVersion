---
import Layout from './Layout.astro';
import PageHero from './PageHero.astro';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import CTASection from './CTASection.astro';

export interface PackageTier {
	name: string;
	for: string;
	price: string;
	priceRange?: string;
	deliverables: string[];
	extras?: string[];
	delivery: string;
	popular?: boolean;
}

export interface PackageData {
	title: string;
	metaTitle: string;
	metaDescription: string;
	heroTitle: string;
	heroSubtitle: string;
	intro: string;
	tiers: PackageTier[];
	notes?: string[];
}

const { data, canonicalPath, breadcrumbLabel } = Astro.props as {
	data: PackageData;
	canonicalPath: string;
	breadcrumbLabel: string;
};

const offerSchema = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: data.title,
	description: data.metaDescription,
	offers: data.tiers.map((t, i) => ({
		'@type': 'Offer',
		position: i + 1,
		name: t.name,
		description: t.for,
		priceCurrency: 'USD',
		price: t.price.replace(/[^0-9.+-]/g, '').replace('+', ''),
	})),
};
---

<Layout
	title={data.metaTitle}
	description={data.metaDescription}
	canonicalPath={canonicalPath}
	jsonLd={offerSchema}
>
	<PageHero
		title={data.heroTitle}
		subtitle={data.heroSubtitle}
		breadcrumb={[
			{ label: 'WordPress', href: '/wordpress-website-development-packages/' },
			{ label: breadcrumbLabel },
		]}
	/>

	<section class="section">
		<div class="container-x">
			<div class="mx-auto max-w-3xl text-center">
				<p class="text-base leading-relaxed text-slate-600">{data.intro}</p>
			</div>
		</div>
	</section>

	<section class="section -mt-8 pt-0">
		<div class="container-x">
			<SectionHeading eyebrow="Pricing Plans" title="Choose the package that fits" center />
			<div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
				{data.tiers.map((t) => (
					<div
						class={`card relative flex flex-col p-7 ${
							t.popular ? 'border-brand-500 shadow-xl ring-2 ring-brand-500' : ''
						}`}
					>
						{t.popular && (
							<span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand-600 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">
								Most popular
							</span>
						)}
						<h3 class="text-lg font-bold text-navy-950">{t.name}</h3>
						<p class="mt-1 text-sm text-slate-500">{t.for}</p>
						<p class="mt-5">
							<span class="text-4xl font-bold text-brand-600">{t.price}</span>
							{t.priceRange && <span class="ml-1 text-sm font-medium text-slate-500">({t.priceRange})</span>}
						</p>
						<p class="mt-1 text-xs font-semibold uppercase tracking-wider text-slate-400">Delivery: {t.delivery}</p>
						<div class="mt-5 flex-1">
							<p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Deliverables</p>
							<ul class="mt-3 space-y-2.5">
								{t.deliverables.map((d) => (
									<li class="flex items-start gap-2 text-sm text-slate-700">
										<Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" />
										{d}
									</li>
								))}
							</ul>
							{t.extras && (
								<>
									<p class="mt-5 text-xs font-semibold uppercase tracking-wider text-slate-500">Also included</p>
									<ul class="mt-3 space-y-2.5">
										{t.extras.map((d) => (
											<li class="flex items-start gap-2 text-sm text-slate-700">
												<Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" />
												{d}
											</li>
										))}
									</ul>
								</>
							)}
						</div>
						<a
							href="/contact-us/"
							class={`mt-7 w-full ${t.popular ? 'btn-primary' : 'btn-outline'}`}
						>
							Choose Plan
						</a>
					</div>
				))}
			</div>
			{data.notes?.length && (
				<ul class="mt-8 space-y-1 text-xs text-slate-500">
					{data.notes.map((n) => (
						<li>• {n}</li>
					))}
				</ul>
			)}
		</div>
	</section>

	<CTASection
		title="Not sure which package fits?"
		subtitle="Tell us about your project and we will recommend the right plan — or tailor a custom package to match your exact needs."
	/>
</Layout>