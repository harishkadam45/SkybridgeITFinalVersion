---
import { SITE } from '../data/site';
import Icon from './Icon.astro';

const servicesLinks = [
	{ label: 'Backend Technologies', href: '/backend-custom-programming-services/' },
	{ label: 'Front End Technologies', href: '/frontend-development-technologies/' },
	{ label: 'Mobile App Development', href: '/mobile-app-development/' },
	{ label: 'Custom Web Applications', href: '/custom-web-application-development/' },
	{ label: 'Software Development', href: '/software-development/' },
	{ label: 'Bulk WhatsApp Marketing', href: '/bulk-whatsapp-marketing-services-for-us-small-medium-businesses/' },
	{ label: 'AI Services', href: '/ai-ugc-content-packages-for-advertising-marketing-agencies/' },
];

const quickLinks = [
	{ label: 'Home', href: '/' },
	{ label: 'About Us', href: '/about-us/' },
	{ label: 'Our Team', href: '/member/' },
	{ label: 'Our Work', href: '/about-us/' },
	{ label: 'AI Services', href: '/ai-ugc-content-packages-for-advertising-marketing-agencies/' },
	{ label: 'AI UGC', href: '/ai-ugc-video-production-workflow/' },
	{ label: 'AI Automation Services', href: '/ai-automation-ai/' },
	{ label: 'Contact Us', href: '/contact-us/' },
];

const moreLinks = [
	{ label: 'Go High Level', href: '/gohighlevel-crm-automation-services-for-small-medium-businesses/' },
	{ label: 'WordPress', href: '/wordpress-website-development-packages/' },
	{ label: 'Gaming App', href: '/gaming-app/' },
	{ label: 'Website Maintenance', href: '/website-maintenance/' },
	{ label: 'Services', href: '/services/' },
	{ label: 'Shopify Development', href: '/shopify-development-services/' },
];
---

<footer class="border-t border-slate-100 bg-white px-4 pb-10 pt-16 text-slate-600 sm:px-8 sm:pt-24">
	<div class="mx-auto max-w-7xl">
		<div class="grid grid-cols-1 gap-10 pb-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12">
			{/* Location */}
			<div>
				<h3 class="text-2xl font-extrabold text-[#0B132A]">Our Location</h3>
				<div class="mb-6 mt-2 h-[2px] w-7 bg-brand-600" />
				{SITE.addresses.map((a) => (
					<div class="mb-6">
						<p class="mb-1 text-base font-bold text-[#0B132A]">{a.label}</p>
						<p class="text-sm">{a.line}</p>
					</div>
				))}
				<p class="mb-4 text-base font-bold text-[#0B132A]">Follow Us</p>
				<div class="flex items-center space-x-2.5">
					<a
						href={SITE.linkedin}
						target="_blank"
						rel="noopener"
						aria-label="LinkedIn"
						class="flex h-9 w-9 items-center justify-center rounded-full bg-[#E0F2FE] text-brand-600 shadow-sm transition-all hover:bg-brand-600 hover:text-white"
					>
						<Icon name="linkedin" class="h-3.5 w-3.5" />
					</a>
					<a
						href={SITE.youtube}
						target="_blank"
						rel="noopener"
						aria-label="YouTube"
						class="flex h-9 w-9 items-center justify-center rounded-full bg-[#E0F2FE] text-brand-600 shadow-sm transition-all hover:bg-brand-600 hover:text-white"
					>
						<Icon name="youtube" class="h-3.5 w-3.5" />
					</a>
					<a
						href={SITE.whatsapp}
						target="_blank"
						rel="noopener"
						aria-label="WhatsApp"
						class="flex h-9 w-9 items-center justify-center rounded-full bg-[#E0F2FE] text-brand-600 shadow-sm transition-all hover:bg-brand-600 hover:text-white"
					>
						<Icon name="whatsapp" class="h-3.5 w-3.5" />
					</a>
				</div>
			</div>

			{/* Services */}
			<nav aria-label="Services">
				<h3 class="text-2xl font-extrabold text-[#0B132A]">Services</h3>
				<div class="mb-6 mt-2 h-[2px] w-7 bg-brand-600" />
				<ul class="space-y-3.5 text-sm font-normal">
					{servicesLinks.map((l) => (
						<li>
							<a href={l.href} class="transition-colors hover:text-brand-600">
								{l.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			{/* Quick Links */}
			<nav aria-label="Quick Links">
				<h3 class="text-2xl font-extrabold text-[#0B132A]">Quick Links</h3>
				<div class="mb-6 mt-2 h-[2px] w-7 bg-brand-600" />
				<ul class="space-y-3.5 text-sm font-normal">
					{quickLinks.map((l) => (
						<li>
							<a href={l.href} class="transition-colors hover:text-brand-600">
								{l.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			{/* More Links */}
			<nav aria-label="More Links">
				<h3 class="text-2xl font-extrabold text-[#0B132A]">More Links</h3>
				<div class="mb-6 mt-2 h-[2px] w-7 bg-brand-600" />
				<ul class="space-y-3.5 text-sm font-normal">
					{moreLinks.map((l) => (
						<li>
							<a href={l.href} class="transition-colors hover:text-brand-600">
								{l.label}
							</a>
						</li>
					))}
				</ul>
				<div class="my-6 border-t border-slate-100" />
				<a href={SITE.isoPath} aria-label={SITE.isoLabel}>
					<img
						src="/images/iso-badge.png"
						alt="ISO 9001:2015 Certified Company"
						class="h-16 w-auto object-contain"
						loading="lazy"
					/>
				</a>
			</nav>
		</div>

		{/* Bottom bar */}
		<div class="mt-4 flex flex-col items-center justify-between gap-4 border-t border-slate-100 pt-8 text-xs text-slate-600 sm:flex-row sm:text-sm">
			<p>
				© {new Date().getFullYear()} Copyright. All Rights Reserved. Created by{' '}
				<span class="font-bold text-[#0B132A]">SkyBridge IT Consulting</span>
			</p>
			<div class="flex flex-wrap items-center gap-2">
				<a href="/about-us/" class="transition-colors hover:text-brand-600">Privacy Policy</a>
				<span aria-hidden="true">|</span>
				<a href="/about-us/" class="transition-colors hover:text-brand-600">Terms of Service</a>
				<span aria-hidden="true">|</span>
				<a href="https://skybridgeit.com/sitemap-index.xml" class="transition-colors hover:text-brand-600">Sitemap</a>
				<span aria-hidden="true">|</span>
				<a href="#top" class="flex items-center gap-2 transition-colors hover:text-brand-600">
					Back to Top
					<span class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 transition-colors hover:border-brand-600 hover:text-brand-600">
						<Icon name="arrowUp" class="h-4 w-4" />
					</span>
				</a>
			</div>
		</div>
	</div>

	{/* WhatsApp floating button */}
	<a
		href={SITE.whatsapp}
		target="_blank"
		rel="noopener"
		class="fixed bottom-5 right-5 z-40 flex h-13 w-13 items-center justify-center rounded-full bg-emerald-500 p-3.5 text-white shadow-lg shadow-emerald-500/30 transition-transform hover:scale-110"
		aria-label="Chat with us on WhatsApp"
	>
		<Icon name="whatsapp" class="h-6 w-6" />
	</a>
</footer>