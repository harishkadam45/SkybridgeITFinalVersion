---
interface Props {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	center?: boolean;
	light?: boolean;
	/** Heading level; section titles are h2 by default */
	as?: 'h1' | 'h2';
	/** id for the heading, so the parent section can use aria-labelledby */
	id?: string;
	class?: string;
}
const { eyebrow, title, subtitle, center = false, light = false, as: Tag = 'h2', id, class: className } = Astro.props;
---

<div class:list={[center ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl', className]}>
	{eyebrow && <span class:list={['eyebrow', light && 'text-brand-300']}>{eyebrow}</span>}
	<Tag id={id} class:list={[Tag === 'h1' ? 'heading-1' : 'heading-2', light && 'text-white']}>{title}</Tag>
	{subtitle && (
		<p class:list={['lead mt-4 max-w-2xl', center && 'mx-auto', light && 'text-slate-300']}>
			{subtitle}
		</p>
	)}
</div>
