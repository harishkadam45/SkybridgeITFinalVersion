---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { NAV } from '../data/site';

const extraLinks = [
	{ label: 'Home', href: '/' },
	{ label: 'ISO 9001:2015 Certification', href: '/iso-certification/' },
];
---

<Layout
	title="Sitemap | SkyBridge IT Consulting"
	description="Browse the full list of SkyBridge IT Consulting pages — services, AI automation, WordPress solutions, company pages and more."
	canonicalPath="/sitemap/"
	noindex
>
	<PageHero
		title="Sitemap"
		subtitle="A complete index of every page on the SkyBridge IT Consulting website."
		breadcrumb={[{ label: 'Sitemap' }]}
	/>

	<section class="section">
		<div class="container-x mx-auto max-w-4xl">
			<SectionHeading eyebrow="Pages" title="Browse the website" center class="section-head" />
			<div class="grid gap-6 sm:grid-cols-2">
				{extraLinks.map((l) => (
					<a href={l.href} class="card group flex items-center justify-between gap-3 p-5 shadow-md transition-transform duration-300 hover:-translate-y-1">
						<span class="font-semibold text-navy-950">{l.label}</span>
						<Icon name="arrowUpRight" class="h-5 w-5 text-brand-500 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
					</a>
				))}
				{NAV.map((n) =>
					n.children ? (
						<div class="card p-5 shadow-md">
							<h3 class="font-bold text-navy-950">{n.label}</h3>
							<ul class="mt-3 space-y-2">
								<li>
									<a href={n.href} class="text-sm font-medium text-brand-700 hover:underline">{n.label} — overview</a>
								</li>
								{n.children.map((c) => (
									<li>
										<a href={c.href} class="text-sm font-medium text-slate-600 hover:text-brand-700 hover:underline">
											{c.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					) : (
						<a href={n.href} class="card group flex items-center justify-between gap-3 p-5 shadow-md transition-transform duration-300 hover:-translate-y-1">
							<span class="font-semibold text-navy-950">{n.label}</span>
							<Icon name="arrowUpRight" class="h-5 w-5 text-brand-500 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
						</a>
					),
				)}
			</div>
		</div>
	</section>
</Layout>