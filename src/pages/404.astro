---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout
	title="Page not found"
	description="The page you are looking for could not be found. It may have moved - head back to the homepage or contact us for help."
	canonicalPath="/404/"
	noindex
>
	<section class="section bg-gradient-brand bg-grid relative overflow-hidden">
		<div class="absolute inset-0 bg-navy-950/40"></div>
		<div class="relative container-x py-24 text-center sm:py-32">
			<p class="text-7xl font-bold text-white/90">404</p>
			<h1 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Page not found</h1>
			<p class="mx-auto mt-4 max-w-xl text-brand-50">
				The page you are looking for may have moved to a new location during our website upgrade.
			</p>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
				<a href="/" class="btn-white">
					<Icon name="arrowRight" class="h-4 w-4 rotate-180" />
					Back to Home
				</a>
				<a href="/services/" class="btn border border-white/50 text-white hover:bg-white/10">Browse services</a>
				<a href="/contact-us/" class="btn border border-white/50 text-white hover:bg-white/10">Contact us</a>
			</div>
		</div>
	</section>
</Layout>