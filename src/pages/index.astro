---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import CTASection from '../components/CTASection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE } from '../data/site';
import { STATS, PORTFOLIO_ITEMS } from '../data/content';

const heroSlides = [
	{
		eyebrow: 'About Our Company',
		lines: ['Web Design, Software &', 'Digital Marketing For', 'Your Business'],
		description:
			'Since 2005, SkyBridge IT Consulting has been the dependable white-label technology partner for agencies, startups and enterprises across the USA, Canada, the UK, Europe and Australia.',
	},
	{
		eyebrow: 'Digital Growth Partners',
		lines: ['Custom Software &', 'Mobile App Development For', 'Scaling Brands'],
		description:
			'We craft high-performing enterprise applications and conversion-driven digital solutions engineered for market leaders - delivered entirely under your brand.',
	},
	{
		eyebrow: 'Intelligent Automation',
		lines: ['AI Solutions &', 'Workflow Automation For', 'Modern Enterprise'],
		description:
			'Automate operational workflows, integrate advanced LLM models, and accelerate business efficiency with custom AI engines built for you.',
	},
];

const serviceCards = [
	{
		title: 'Web Development',
		desc: 'Custom websites, portals, SaaS platforms, and web applications built for agencies serving corporate, startup, and enterprise clients.',
		href: '/services/',
		img: '/images/services/requirement-analysis.webp',
	},
	{
		title: 'Mobile App Development',
		desc: 'Native iOS (Swift), Android (Kotlin/Flutter), and cross-platform mobile apps designed for performance and security.',
		href: '/mobile-app-development/',
		img: '/images/services/mobile-app.webp',
	},
	{
		title: 'Custom Software Development',
		desc: 'Enterprise software, SaaS products, CRM systems, and custom business applications tailored to client needs.',
		href: '/software-development/',
		img: '/images/services/software-development.webp',
	},
	{
		title: 'CRM & GoHighLevel Automation',
		desc: 'Complete CRM setup, workflow automation, lead nurturing systems, and sales pipeline management for marketing agencies.',
		href: '/gohighlevel-crm-automation-services-for-small-medium-businesses/',
		img: '/images/services/whatsapp-marketing.webp',
	},
	{
		title: 'AI & Business Automation',
		desc: 'AI chatbots, LLM integration, workflow automation, and intelligent business tools designed to increase efficiency.',
		href: '/ai-automation-ai/',
		img: '/images/services/ai-automation.webp',
	},
	{
		title: 'UI/UX & Product Design',
		desc: 'User-centric wireframing, prototyping, and high-fidelity interface design built for high conversion.',
		href: '/frontend-development-technologies/',
		img: '/images/services/uiux-design.webp',
	},
	{
		title: 'Cloud Migration & DevOps',
		desc: 'AWS, GCP, and Azure infrastructure setup, CI/CD pipeline automation, and zero-downtime scaling.',
		href: '/backend-custom-programming-services/',
		img: '/images/services/cloud-devops.webp',
	},
	{
		title: 'Dedicated White-Label Teams',
		desc: 'Long-term dedicated developers, designers, and engineers working as an invisible extension of your agency.',
		href: '/about-us/',
		img: '/images/services/dedicated-teams.webp',
	},
	{
		title: 'Cybersecurity & Compliance',
		desc: 'SOC 2 compliance support, vulnerability audits, data encryption, and secure API integration.',
		href: '/services/',
		img: '/images/services/cybersecurity.webp',
	},
];

const whyPartner = [
	{
		title: 'Innovation',
		icon: 'bulb',
		desc: 'We combine technical excellence with strategic business insight to deliver platforms that accelerate growth and optimize operations.',
	},
	{
		title: 'Quality-Focused',
		icon: 'ribbon',
		desc: 'Rigorous QA, code reviews, and security-first engineering ensure every release meets enterprise-grade standards.',
	},
	{
		title: 'Value For Money',
		icon: 'coins',
		desc: 'Flexible white-label engagement models give you senior engineering capacity at predictable, agency-friendly pricing.',
	},
];

/*
 * Logo sizes are normalised by visible area (not height), so a wide wordmark
 * and a compact icon read with the same visual weight inside identical tiles.
 * Source files are pre-trimmed to their visible bounds (public/images/tech/*.webp).
 */
type Tech = { name: string; src: string; w: number; h: number; tag: string };
const tech = (name: string, file: string, w: number, h: number, tag: string): Tech => ({
	name,
	src: `/images/tech/${file}.webp`,
	w,
	h,
	tag,
});

const techRows: { label: string; reverse?: boolean; duration: string; items: Tech[] }[] = [
	{
		label: 'Backend, cloud & DevOps',
		duration: '46s',
		items: [
			tech('Redis', 'redis', 100, 34, 'Backend'),
			tech('GraphQL', 'graphql', 113, 30, 'Backend'),
			tech('PostgreSQL', 'postgres', 142, 23, 'Database'),
			tech('Docker', 'docker', 122, 28, 'DevOps'),
			tech('AWS', 'aws', 67, 40, 'Cloud'),
			tech('Google Cloud', 'gcloud', 139, 22, 'Cloud'),
			tech('Kubernetes', 'kubernetes', 132, 23, 'DevOps'),
		],
	},
	{
		label: 'Frontend, design & mobile',
		reverse: true,
		duration: '40s',
		items: [
			tech('React & React Native', 'react', 109, 38, 'Web & Mobile'),
			tech('Next.js', 'next', 118, 22, 'Frontend'),
			tech('Vue.js', 'vuejs', 98, 35, 'Frontend'),
			tech('Figma', 'figma', 84, 40, 'Design'),
			tech('Swift', 'swift', 93, 28, 'iOS'),
			tech('Kotlin', 'kotlin', 106, 23, 'Android'),
		],
	},
];

const orgSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: SITE.name,
	url: SITE.url,
	email: SITE.email,
	telephone: '12673889414',
	description: SITE.description,
	sameAs: [SITE.linkedin, SITE.youtube],
	address: [
		{
			'@type': 'PostalAddress',
			streetAddress: SITE.addresses[0].line.split(',')[0],
			addressLocality: 'Staten Island',
			addressRegion: 'NY',
			postalCode: '10302',
			addressCountry: 'US',
		},
	],
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE.name,
	url: SITE.url,
};
---

<Layout
	title="White-Label Web Development Partner for Agencies"
	description="SkyBridge IT Consulting - white-label web development, WordPress, mobile apps, custom software, AI automation and GoHighLevel services for agencies since 2005. ISO 9001:2015 certified, 24/7 support."
	canonicalPath="/"
	jsonLd={[orgSchema, websiteSchema]}
>
	<!-- Hero -->
	<section id="hero" class="relative isolate overflow-hidden bg-white pb-16 pt-12 sm:pb-20 sm:pt-16 lg:pb-24 lg:pt-20">
		<!-- Concentric arc lines -->
		<div class="pointer-events-none absolute inset-0 -z-10 flex items-end justify-center overflow-hidden" aria-hidden="true">
			<svg class="h-[700px] w-[1400px] max-w-none translate-y-40 opacity-30" viewBox="0 0 1000 500" fill="none">
				<circle cx="500" cy="500" r="450" stroke="#0095FF" stroke-width="1" stroke-dasharray="2 4" />
				<circle cx="500" cy="500" r="370" stroke="#38BDF8" stroke-width="1.2" />
				<circle cx="500" cy="500" r="290" stroke="#0095FF" stroke-width="1" stroke-dasharray="3 3" />
				<circle cx="500" cy="500" r="210" stroke="#93C5FD" stroke-width="1.5" />
				<circle cx="500" cy="500" r="130" stroke="#0095FF" stroke-width="1" />
			</svg>
		</div>

		<div class="container-x flex flex-col items-center text-center">
			<!-- Hero carousel -->
			<div class="w-full max-w-4xl" data-hero-carousel aria-roledescription="carousel" aria-label="SkyBridge highlights">
				<div class="grid">
					{heroSlides.map((slide, i) => {
						// Only the first slide is the page's H1; the rotating alternates are paragraphs
						const Title = i === 0 ? 'h1' : 'p';
						return (
							<div
								class:list={[
									'col-start-1 row-start-1 flex flex-col items-center transition-opacity duration-700',
									i === 0 ? 'opacity-100' : 'pointer-events-none opacity-0',
								]}
								data-slide={i}
								aria-hidden={i === 0 ? 'false' : 'true'}
							>
								<span class="eyebrow mb-4">{slide.eyebrow}</span>
								<Title class="heading-display">
									{slide.lines.map((line, li) => (
										<span class:list={['sm:block', li === slide.lines.length - 1 && 'text-brand-600']}>
											{line}{' '}
										</span>
									))}
								</Title>
								<p class="lead mx-auto mt-6 max-w-2xl">{slide.description}</p>
							</div>
						);
					})}
				</div>
				<div class="mt-6 flex items-center justify-center" data-hero-pagination></div>
			</div>

			<!-- CTA buttons -->
			<div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
				<a href="/contact-us/" class="btn-primary px-8 text-base">
					<span>Free Consultation</span>
					<Icon name="arrowRight" class="h-4 w-4" />
				</a>
				<a href="/contact-us/" class="btn-outline px-8 text-base">
					<span>Start a Project</span>
					<Icon name="arrowRight" class="h-4 w-4" />
				</a>
			</div>

			<!-- Stats card -->
			<dl class="mt-14 grid w-full max-w-5xl grid-cols-2 gap-y-2 rounded-[28px] border border-slate-100 bg-gray-100 p-4 custom-shadow sm:mt-16 sm:p-8 md:grid-cols-4">
				{STATS.map((s, i) => (
					<div class:list={['flex flex-col-reverse items-center p-4 text-center', i % 4 !== 3 && 'md:border-r md:border-slate-100']}>
						<dt class="text-xs font-bold uppercase tracking-wider text-slate-500">{s.label}</dt>
						<dd class="mb-2 text-3xl font-extrabold tracking-tight text-navy-950 sm:text-4xl">
							{s.value}<span class="text-brand-600">{s.suffix}</span>
						</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	<!-- About Company -->
	<section id="about" class="section bg-white" aria-labelledby="about-title">
		<div class="container-x grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
			<div class="group relative overflow-hidden rounded-[28px] bg-slate-100 shadow-sm">
				<img
					src="/images/team-collab.webp"
					alt="SkyBridge engineers collaborating on a client project"
					class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-105 lg:aspect-[5/4]"
					width="1000"
					height="667"
					loading="lazy"
					decoding="async"
				/>
			</div>

			<div>
				<SectionHeading
					id="about-title"
					eyebrow="About Our Company"
					title="Websites that tell your brand’s story"
				/>
				<div class="mt-6 space-y-4 text-base leading-relaxed text-slate-600">
					<p>At SkyBridge IT Consulting, we combine technical excellence with strategic business insight to deliver software platforms that accelerate growth and optimize operations.</p>
					<p>Our multi-disciplinary team of software architects, cloud engineers, and UI/UX designers collaborate closely with clients to build secure, scalable digital products.</p>
					<p>From initial strategy and modern frontend design to robust backend APIs and automated cloud deployments, we ensure your technology stack remains future-proof.</p>
				</div>

				<ul class="mt-8 grid grid-cols-1 gap-x-6 gap-y-3.5 sm:grid-cols-2">
					{['Requirement Analysis', 'Custom Software Development', 'Cloud Migration & DevOps', 'Dedicated Development Teams', '24/7 Technical Support', 'Quality Assurance'].map((point) => (
						<li class="flex items-center gap-3">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700 ring-1 ring-brand-100">
								<Icon name="check" class="h-3.5 w-3.5" />
							</span>
							<span class="text-[15px] font-semibold text-navy-950">{point}</span>
						</li>
					))}
				</ul>

				<a href="/contact-us/" class="btn-primary mt-10">
					<span>Free Consultation</span>
					<Icon name="arrowRight" class="h-4 w-4" />
				</a>
			</div>
		</div>
	</section>

	<!-- Services -->
	<section id="services" class="section bg-white" aria-labelledby="services-title">
		<div class="container-x">
			<div class="section-head flex flex-col justify-between gap-6 md:flex-row md:items-end">
				<SectionHeading
					id="services-title"
					eyebrow="Our Services"
					title="What we can offer today"
					subtitle="End-to-end engineering, automation and design - delivered under your brand."
				/>
				<a href="/services/" class="btn-primary shrink-0 self-start md:self-auto">
					<span>View All Services</span>
					<Icon name="arrowUpRight" class="h-4 w-4" />
				</a>
			</div>

			<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
				{serviceCards.map((s) => (
					<a
						href={s.href}
						class="group flex flex-col rounded-[28px] border border-slate-100 bg-gray-100 p-6 custom-shadow transition-[translate,box-shadow] duration-300 hover:-translate-y-1.5 hover:custom-shadow-hover sm:p-7"
					>
						<div class="mb-3 flex items-start justify-between gap-4">
							<h3 class="heading-3 transition-colors group-hover:text-brand-700">{s.title}</h3>
							<span
								class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-700 text-white shadow-md shadow-brand-700/25 transition-transform duration-300 group-hover:rotate-45"
								aria-hidden="true"
							>
								<Icon name="arrowUpRight" class="h-5 w-5" />
							</span>
						</div>
						<p class="body-sm mb-6 flex-1">{s.desc}</p>
						<div class="overflow-hidden rounded-[20px] bg-slate-100">
							<img
								src={s.img}
								alt=""
								class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-105"
								width="600"
								height="375"
								loading="lazy"
								decoding="async"
							/>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Why Partner With Us -->
	<section id="why-partner" class="section bg-white" aria-labelledby="why-title">
		<div class="container-x">
			<SectionHeading id="why-title" eyebrow="Our Differences" title="Why partner with us?" class="section-head" />

			<div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
				{whyPartner.map((w) => (
					<div class="group rounded-[28px] border border-slate-100 bg-gray-100 p-7 custom-shadow transition-[translate,box-shadow] duration-300 hover:-translate-y-1.5 hover:custom-shadow-hover sm:p-8">
						<div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-ice-blue text-brand-600 ring-1 ring-brand-100">
							<Icon name={w.icon} class="h-6 w-6" />
						</div>
						<h3 class="heading-3 mb-3 transition-colors group-hover:text-brand-700">{w.title}</h3>
						<p class="body-sm">{w.desc}</p>
					</div>
				))}
			</div>

			<!-- CTA banner -->
			<div class="mt-6 rounded-[28px] border border-brand-100 bg-gradient-to-br from-ice-blue to-white p-7 sm:p-10 lg:mt-8 lg:p-12">
				<div class="flex flex-col items-center gap-6 text-center lg:flex-row lg:gap-10 lg:text-left">
					<span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white text-brand-600 shadow-sm ring-1 ring-brand-100">
						<Icon name="globe" class="h-7 w-7" />
					</span>
					<div class="flex-1">
						<h3 class="text-2xl font-bold leading-snug tracking-tight sm:text-[1.75rem]">
							Do you want to explore our outstanding work?
						</h3>
						<p class="body-sm mt-3 max-w-2xl">
							From conversion-focused marketing sites to enterprise SaaS platforms, we deliver work our partners proudly
							present as their own. Explore case studies, demos, and client success stories.
						</p>
					</div>
					<div class="flex shrink-0 flex-wrap items-center justify-center gap-3">
						{[
							{ href: SITE.youtube, label: 'YouTube', icon: 'youtube', external: true },
							{ href: SITE.linkedin, label: 'LinkedIn', icon: 'linkedin', external: true },
							{ href: '/contact-us/', label: 'Contact Us', icon: null, external: false },
						].map((l) => (
							<a
								href={l.href}
								target={l.external ? '_blank' : undefined}
								rel={l.external ? 'noopener' : undefined}
								class="inline-flex min-h-11 items-center gap-2 rounded-full border border-slate-200 bg-white px-5 text-sm font-bold text-slate-800 transition-colors hover:border-brand-700 hover:text-brand-700"
							>
								{l.icon && <Icon name={l.icon} class="h-4 w-4" />}
								{l.label}
								<Icon name="arrowUpRight" class="h-4 w-4" />
							</a>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Technologies -->
	<section id="technologies" class="section overflow-hidden bg-white" aria-labelledby="tech-title">
		<div class="container-x">
			<SectionHeading
				id="tech-title"
				eyebrow="Technologies"
				title="The tools we build with"
				subtitle="A production-grade stack across every discipline - from APIs and cloud to polished interfaces and native mobile."
				center
				class="section-head"
			/>
		</div>

		<div class="mx-auto max-w-[1440px] space-y-4 sm:space-y-5">
			{techRows.map((row) => (
				<div class="marquee mask-fade-x overflow-hidden py-2" role="group" aria-label={row.label}>
					<ul class="animate-marquee" data-reverse={row.reverse ? '' : undefined} style={`--marquee-duration:${row.duration}`}>
						{/* 4 copies: two per half, so the -50% loop is seamless on ultra-wide screens */}
						{[0, 1, 2, 3].map((copy) =>
							row.items.map((t) => (
								<li
									class="mr-4 flex h-24 w-44 shrink-0 flex-col items-center justify-center gap-2 rounded-2xl border border-slate-200/70 bg-gray-100 px-4 shadow-[0_1px_2px_rgba(11,19,42,0.04)] transition-[border-color,box-shadow] duration-200 hover:border-brand-200 hover:shadow-md sm:mr-5 sm:w-48"
									data-clone={copy > 0 ? '' : undefined}
									aria-hidden={copy > 0 ? 'true' : undefined}
								>
									<span class="flex h-10 items-center justify-center">
										<img
											src={t.src}
											alt={copy > 0 ? '' : t.name}
											width={t.w}
											height={t.h}
											style={`width:${t.w}px;height:${t.h}px`}
											class="object-contain"
											loading="lazy"
											decoding="async"
										/>
									</span>
									<span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">{t.tag}</span>
								</li>
							)),
						)}
					</ul>
				</div>
			))}
		</div>
	</section>

	<!-- Our Work -->
	<section id="work" class="section bg-white" aria-labelledby="work-title">
		<div class="container-x">
			<div class="section-head flex flex-col justify-between gap-6 md:flex-row md:items-end">
				<SectionHeading
					id="work-title"
					eyebrow="Our Work"
					title="High-quality digital products, delivered."
				/>
				<a href="/about-us/" class="btn-outline shrink-0 self-start md:self-auto">
					<span>Explore Our Work</span>
					<Icon name="arrowUpRight" class="h-4 w-4" />
				</a>
			</div>

			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
				{PORTFOLIO_ITEMS.map((p) => (
					<a
						href={p.href}
						class="group flex flex-col rounded-[28px] border border-slate-100 bg-gray-100 p-4 custom-shadow transition-[translate,box-shadow] duration-300 hover:-translate-y-1.5 hover:custom-shadow-hover sm:p-5"
					>
						<div class="overflow-hidden rounded-[20px] bg-slate-100">
							<img
								src={p.img}
								alt=""
								class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
								width="390"
								height="293"
								loading="lazy"
								decoding="async"
							/>
						</div>
						<div class="px-2 pb-2 pt-5">
							<span class="mb-2 block text-sm font-medium text-slate-500">{p.category}</span>
							<h3 class="text-lg font-bold leading-snug transition-colors group-hover:text-brand-700 sm:text-xl">
								{p.title}
							</h3>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<TestimonialsSection tone="muted" />

	<CTASection />
</Layout>

<script>
	// Hero crossfade carousel: 5.5s autoplay, clickable dots, paused on hover/focus, off for reduced motion
	const heroCarousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
	if (heroCarousel) {
		const slides = Array.from(heroCarousel.querySelectorAll<HTMLElement>('[data-slide]'));
		const pagination = heroCarousel.querySelector<HTMLElement>('[data-hero-pagination]');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let current = 0;
		let interval: number | undefined;

		const dots = slides.map((_, i) => {
			const dot = document.createElement('button');
			dot.type = 'button';
			dot.className = 'carousel-dot';
			dot.setAttribute('aria-label', `Show highlight ${i + 1}`);
			dot.addEventListener('click', () => {
				current = i;
				show();
				restart();
			});
			pagination?.appendChild(dot);
			return dot;
		});

		function show() {
			slides.forEach((slide, i) => {
				const active = i === current;
				slide.classList.toggle('opacity-100', active);
				slide.classList.toggle('opacity-0', !active);
				slide.classList.toggle('pointer-events-none', !active);
				slide.setAttribute('aria-hidden', String(!active));
			});
			dots.forEach((d, i) => d.setAttribute('aria-current', String(i === current)));
		}

		function stop() {
			window.clearInterval(interval);
		}
		function restart() {
			stop();
			if (reduceMotion) return;
			interval = window.setInterval(() => {
				current = (current + 1) % slides.length;
				show();
			}, 5500);
		}
		heroCarousel.addEventListener('mouseenter', stop);
		heroCarousel.addEventListener('mouseleave', restart);
		heroCarousel.addEventListener('focusin', stop);
		heroCarousel.addEventListener('focusout', restart);

		show();
		restart();
	}
</script>
